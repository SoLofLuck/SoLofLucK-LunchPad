# Which cluster the site talks to: devnet | mainnet-beta
VITE_NETWORK=devnet
# A dedicated RPC (Helius, Triton, ...) is strongly recommended; the public
# endpoints rate-limit history lookups used by charts.
VITE_RPC_URL=
# Deployed launchpad program. Defaults to the address in the bundled IDL.
VITE_PROGRAM_ID=
# Pinata JWT with Files:Write only, for logo + metadata uploads.
VITE_PINATA_JWT=
